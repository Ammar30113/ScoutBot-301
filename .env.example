# Simulated money only. No brokerage credentials are required.
MODE=paper
BROKER=simulated
STRATEGY=daily_trend
ALLOW_LIVE_TRADING=false
# false submits SIMULATED orders; true records decisions only.
DRY_RUN=false
PAPER_ACCOUNT_ID=scout-paper-v1
PAPER_STATE_PATH=data/paper.sqlite3
PAPER_INITIAL_CASH_USD=10000
PAPER_SYMBOLS=SPY,QQQ,IWM
PAPER_DATA_PROVIDER=twelvedata
TWELVEDATA_API_KEY=
# Alternative: set PAPER_DATA_PROVIDER=marketstack and supply this instead.
MARKETSTACK_API_KEY=

# USD notional caps, including pending entries. No leverage or automatic top-ups.
DAILY_BUDGET_USD=5000
MAX_POSITION_SIZE=1000
MAX_POSITION_PCT=0.10
MAX_POSITIONS=2
MAX_UNIVERSE_SIZE=3
MAX_GROSS_EXPOSURE_PCT=0.50
MAX_RISK_PCT=0.005
MAX_PORTFOLIO_RISK_PCT=0.01
MAX_DAILY_LOSS_PCT=0.01
MAX_DRAWDOWN_PCT=0.05

# Engineering assumptions, NOT an IBKR commission quote.
PAPER_SLIPPAGE_BPS=10
PAPER_FEE_BPS=5
PAPER_MIN_FEE_USD=0.35
TREND_DAYS=200
DATA_DELAY_SECONDS=900
SCHEDULER_INTERVAL_SECONDS=900
CACHE_TTL=60
MARKETSTACK_CACHE_TTL=900

# Optional HTTPS monitoring URL. Only healthy cycles send a heartbeat.
HEARTBEAT_URL=

# Retired features cannot be enabled on this worker.
ALLOW_ALPACA_DAILY=false
ALLOW_FALLBACK_ML=false
ALLOW_SYNTHETIC_ML=false
TRAIN_ML_ON_STARTUP=false
USE_SENTIMENT=false
USE_TWITTER_NEWS=false
UNIVERSE_FALLBACK_ONLY=false
UNIVERSE_ALLOW_UNFILTERED_FALLBACK=false
REQUIRE_CRASH_DATA=false
STRIP_RATE_LIMITED_KEYS=false
